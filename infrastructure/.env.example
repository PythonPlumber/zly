# ── Production (Docker) ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://zly:your-db-password@postgres:5432/zly
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-random-64-char-string
JWT_SECRET=replace-with-random-64-char-string
CORS_ORIGINS=http://localhost:8000
DEFAULT_DOMAIN=localhost:8000
ENVIRONMENT=production
# RATE_LIMIT_ENABLED=true   # uncomment to enable rate limiting (3 zones: auth 10/min, api 60/min, redirect 100/min)

# ── Local Dev (SQLite, no Redis required) ────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///./zly.db
# REDIS_URL=
# SECRET_KEY=change-me-in-production
# JWT_SECRET=change-me-in-production
# CORS_ORIGINS=http://localhost:8000
# DEFAULT_DOMAIN=localhost:8000
